# Generated local output (gitignored, but Docker doesn't read .gitignore). CodeBuild clones
# a clean checkout, so this only affects local devbuild context size (#4599). Keep coverage/
# itself: it holds tracked summary files, and coverage runs write cover_db inside the container.
screenshots/
coverage/cover_db/
coverage/html/
coverage/react/
test-results/
playwright-report/
playwright/.cache/
# tools/e2e-demo.sh recordings and stills (never part of the image).
e2e-demos/
*.mp4
*.webm
# Untracked local-only directory; excluded here instead of deleted in the image (#4623).
local
